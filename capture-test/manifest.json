{
  "manifest_version": 3,
  "name": "Sarmaaya Video Recorder",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "One-click full-lecture recording with auto-play, clean view, and smart pause trimming.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "downloads", "storage"],
  "host_permissions": ["https://learn.sarmaaya.pk/*", "https://iframe.mediadelivery.net/*"],
  "action": {"default_title": "Start / stop lecture recording"},
  "background": {"service_worker": "background.js", "type": "module"}
}
